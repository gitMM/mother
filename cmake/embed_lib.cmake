# Writes OUT, a C++ file holding every lib/**/*.luau file under LIB_DIR as a byte array, so
# MOTHERLIB ships inside the binary. Modules are named by their path without ".luau"
# ("core/world") and listed in sorted order.
# Usage: cmake -DLIB_DIR=<dir> -DOUT=<file.cpp> -P embed_lib.cmake

file(GLOB_RECURSE files RELATIVE ${LIB_DIR} ${LIB_DIR}/*.luau)
list(SORT files)
string(REPEAT "[0-9a-f]" 64 row)

set(arrays "")
set(entries "")
set(i 0)
foreach(file ${files})
    file(READ ${LIB_DIR}/${file} hex HEX)
    string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "\\.luau$" "" name ${file})
    string(APPEND arrays "const unsigned char k${i}[] = {\n${hex}0x00};\n")
    string(APPEND entries "    {\"${name}\", reinterpret_cast<const char*>(k${i}), sizeof k${i} - 1},\n")
    math(EXPR i "${i} + 1")
endforeach()

set(text "// Generated by cmake/embed_lib.cmake from lib/. Do not edit.\n")
string(APPEND text "#include \"vm/lib_sources.h\"\n\nnamespace mother {\n\nnamespace {\n\n${arrays}\n}  // namespace\n\n")
string(APPEND text "const LibSource kLibSources[] = {\n${entries}};\n\nconst size_t kLibSourceCount = ${i};\n\n}  // namespace mother\n")

# Only touch the file when it changes, so an unchanged lib doesn't trigger a rebuild.
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
